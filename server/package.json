{
  "name": "honey-do-list",
  "version": "1.0.0",
  "description": "The development of a Honey Do List, a shared task management list designed for couples. The system will allow partners to create, assign, and track tasks in real-time, reducing miscommunication and improving household productivity. The features will support comments, tags, and the severity of the tasks, deadlines, reminders, and progress tasks.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "seed": "node seedUsers.js"
  },
  "keywords": [
    "task-management",
    "couples",
    "productivity"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "mongoose": "^7.8.7"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.2.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/?(*.)+(spec|test).js"
    ],
    "collectCoverageFrom": [
      "**/*.js",
      "!**/node_modules/**",
      "!**/coverage/**",
      "!jest.config.js",
      "!seedUsers.js"
    ],
    "testTimeout": 30000
  }
}
